---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import DistributorDialog from "../components/DistributorDialog.astro";
// Fonts used in the first viewport, preloaded so headlines do not reflow on swap.
import poppins600 from "@fontsource/poppins/files/poppins-latin-600-normal.woff2?url";
import poppins700 from "@fontsource/poppins/files/poppins-latin-700-normal.woff2?url";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import { DEFAULT_SHARE_IMAGE, SITE_NAME, absoluteUrl, graph, type ShareImage } from "../lib/seo";
import { DEFAULT_LOCALE, LOCALES, type Locale } from "../i18n/locales";
import { ui } from "../i18n/ui";
import type { Alternate } from "../lib/articles";

interface Props {
  title: string;
  description: string;
  /** Category slug (or "articles") highlighted in the navigation. */
  current?: string;
  /** Open Graph type: "article" for articles, "website" otherwise. */
  ogType?: "website" | "article";
  /** schema.org nodes for this page, emitted as one JSON-LD @graph. */
  jsonLd?: Record<string, unknown>[];
  /** Error pages: no canonical, kept out of the index. */
  noindex?: boolean;
  /** Share image (raster, ≥ 1200 px wide). Defaults to the brand image. */
  image?: ShareImage;
  /** Language of the page. */
  locale?: Locale;
  /**
   * Published language versions of this page, itself included. hreflang
   * links are emitted only when there are at least two
   * (docs/architecture/INTERNATIONAL_SEO_ARCHITECTURE.md).
   */
  alternates?: Alternate[];
}

const {
  title,
  description,
  current,
  ogType = "website",
  jsonLd = [],
  noindex = false,
  image = DEFAULT_SHARE_IMAGE,
  locale = DEFAULT_LOCALE,
  alternates = [],
} = Astro.props;
const lang = LOCALES[locale];
const t = ui(locale);
const hreflangs = !noindex && alternates.length > 1 ? alternates : [];
const xDefault = hreflangs.find((a) => a.locale === DEFAULT_LOCALE);
const fullTitle = title === "Aloessential" ? "Aloessential — Naturellement essentiel" : `${title} · Aloessential`;
const canonical = absoluteUrl(Astro.url.pathname, Astro.site);
const ogImage = absoluteUrl(image.src, Astro.site);
---

<!doctype html>
<html lang={lang.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {/* Lets Google show large image previews (Discover, results). docs/architecture/IMAGE_DELIVERY.md */}
    {!noindex && <meta name="robots" content="max-image-preview:large" />}
    <meta name="theme-color" content="#0F5132" />
    <meta property="og:site_name" content={SITE_NAME} />
    {hreflangs.map((a) => <link rel="alternate" hreflang={a.hreflang} href={absoluteUrl(a.path, Astro.site)} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={absoluteUrl(xDefault.path, Astro.site)} />}
    <meta property="og:locale" content={lang.ogLocale} />
    {
      hreflangs
        .filter((a) => a.locale !== locale)
        .map((a) => <meta property="og:locale:alternate" content={LOCALES[a.locale].ogLocale} />)
    }
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    {image.alt && <meta property="og:image:alt" content={image.alt} />}
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.length > 0 && <script type="application/ld+json" set:html={graph(jsonLd)} />}
    <link rel="preload" href={poppins700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={poppins600} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <!--
      Motion boot: runs before first paint.
      `.js`     → JavaScript is available (mobile menu becomes a toggle).
      `.motion` → reveal-on-scroll may hide content until it enters the viewport.
      Failsafe: if the motion module has not started within 3s, drop `.motion`
      so nothing can stay hidden.
    -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add("js");
        if ("IntersectionObserver" in window) {
          d.classList.add("motion");
          setTimeout(function () {
            if (!("revealReady" in d.dataset)) d.classList.remove("motion");
          }, 3000);
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipLink}</a>
    <Header current={current} locale={locale} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <DistributorDialog locale={locale} />
    <script>
      import "../scripts/motion";
    </script>
  </body>
</html>
