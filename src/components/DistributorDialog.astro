---
import Icon from "./Icon.astro";
import { PUBLISHER, whatsappUrl } from "../data/site";
import { DEFAULT_LOCALE, type Locale } from "../i18n/locales";
import { ui } from "../i18n/ui";

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const t = ui(locale);
const firstName = PUBLISHER.name.split(" ")[0];

/*
 * Floating "Devenir distributeur LR" button. Without JavaScript it is a plain
 * link to the contact page section; with JavaScript it opens a native modal
 * <dialog> (focus trap, Escape and backdrop close handled by the browser).
 * It never opens on its own.
 */
---

<a
  class="distributor-fab"
  href="/contact/#distributeur"
  hreflang={locale === DEFAULT_LOCALE ? undefined : "fr"}
  data-distributor-open
>
  <Icon name="message" />
  <span>{t.distributorFab}</span>
</a>

<dialog class="distributor-dialog" id="distributor-dialog" aria-labelledby="distributor-dialog-title">
  <div class="distributor-dialog__body">
    <form method="dialog" class="distributor-dialog__close">
      <button type="submit" aria-label={t.close}><Icon name="close" /></button>
    </form>
    <p class="eyebrow">{t.distributorEyebrow}</p>
    <h2 id="distributor-dialog-title">{t.distributorTitle}</h2>
    <p>{t.distributorBody(PUBLISHER.name)}</p>
    <p class="distributor__note">{t.distributorNote}</p>
    <div class="distributor__actions">
      <a class="btn btn--sun" href={whatsappUrl(t.distributorMessage(firstName))} target="_blank" rel="noopener">
        <Icon name="message" class="btn__icon" />
        {t.distributorWhatsapp}
        <span class="visually-hidden">{t.newTab}</span>
      </a>
      <a class="distributor__phone" href={PUBLISHER.phoneHref}>{PUBLISHER.phone}</a>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.getElementById("distributor-dialog") as HTMLDialogElement | null;
  const opener = document.querySelector<HTMLAnchorElement>("[data-distributor-open]");
  if (dialog && opener && typeof dialog.showModal === "function") {
    opener.addEventListener("click", (event) => {
      event.preventDefault();
      dialog.showModal();
    });
    // A click on the backdrop (outside the dialog box) closes it.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener("close", () => opener.focus());
  }
</script>
