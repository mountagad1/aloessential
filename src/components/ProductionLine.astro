---
import Icon from "./Icon.astro";

/*
 * "Du champ au flacon": how aloe vera gel is generally produced, in six steps.
 * Generic process, true of the sector as a whole: it does not describe any
 * one brand's factory. Each step is a note pinned on lined paper; on wide
 * screens the notes zig-zag and a dashed path links them, drawn as the board
 * scrolls through the viewport (CSS scroll-driven animation, no loop; drawn
 * in full without support or with reduced motion). Notes reveal with the
 * shared data-reveal system.
 */
const CONNECTOR =
  "M26 10 C55 10 45 30 74 30 C45 30 55 50 26 50 C55 50 45 70 74 70 C45 70 55 90 26 90 C55 90 45 110 74 110";
const steps = [
  {
    icon: "sun",
    title: "Culture",
    text: "Aloe barbadensis Miller pousse en plein soleil, sur des sols bien drainés. C'est l'espèce utilisée pour l'alimentation et la cosmétique.",
  },
  {
    icon: "knife",
    title: "Récolte à la main",
    text: "On coupe à la base les feuilles extérieures, les plus mûres. Le cœur de la plante reste en place et continue de pousser.",
  },
  {
    icon: "truck",
    title: "Transport rapide",
    text: "Une fois coupé, le gel s'oxyde. Les feuilles sont lavées et transformées au plus vite après la récolte.",
  },
  {
    icon: "layers",
    title: "Filetage",
    text: "L'écorce verte et le latex jaune, riche en aloïne, sont retirés. Seul le gel translucide du centre de la feuille est conservé.",
  },
  {
    icon: "filter",
    title: "Filtration et stabilisation",
    text: "Le gel est filtré, souvent décoloré pour réduire sa teneur en aloïne, puis stabilisé pour qu'il se conserve.",
  },
  {
    icon: "bottle",
    title: "Contrôle et flacon",
    text: "Teneur en aloe, aloïne, qualité microbiologique : le lot est analysé avant d'être conditionné. Certains producteurs le font certifier.",
  },
] as const;
---

<section class="section production" aria-labelledby="production-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">Du champ au flacon</p>
        <h2 id="production-title">Comment naît un gel d'aloe vera</h2>
        <p class="production__lead">
          Six étapes séparent une feuille fraîchement coupée du produit que vous achetez. Les connaître aide à lire une
          étiquette et à reconnaître un produit soigné.
        </p>
      </div>
    </div>

    <div class="production__board">
      <svg class="production__path" viewBox="0 0 100 120" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d={CONNECTOR} />
      </svg>
      <ol class="production__line">
        {
          steps.map((step, i) => (
            <li class="production__step" data-reveal>
              <div class="production__note">
                <div class="production__top">
                  <p class="production__number">
                    <span class="visually-hidden">Étape </span>
                    {String(i + 1).padStart(2, "0")}
                  </p>
                  <span class="production__node">
                    <Icon name={step.icon} />
                  </span>
                </div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <p class="production__more" data-reveal>
      <a class="text-link" href="/articles/choisir-gel-aloe-vera/">
        Bien choisir son gel d'aloe vera <Icon name="arrow-right" class="btn__icon" />
      </a>
      <a class="text-link" href="/articles/aloe-vera-a-boire-comment-choisir/">
        Aloe vera à boire : comment le choisir <Icon name="arrow-right" class="btn__icon" />
      </a>
    </p>
  </div>
</section>
