---
import Icon from "./Icon.astro";
import { withPartnerRef } from "../lib/partner";
import { DEFAULT_LOCALE, type Locale } from "../i18n/locales";
import { productUi } from "../i18n/product-ui";

interface Props {
  href: string;
  productName: string;
  variant?: "sun" | "primary" | "outline";
  label?: string;
  class?: string;
  locale?: Locale;
}

const { href, productName, variant = "sun", locale = DEFAULT_LOCALE, class: className } = Astro.props;
const p = productUi(locale);
const label = Astro.props.label ?? p.shopButton;
---

<a
  class:list={["btn", "shop-btn", { "btn--sun": variant === "sun", "btn--outline": variant === "outline" }, className]}
  href={withPartnerRef(href)}
  target="_blank"
  rel="sponsored noopener"
  data-shop-link
>
  {label}<span class="visually-hidden">{p.shopButtonHidden(productName)}</span>
  <Icon name="external" class="btn__icon" />
</a>
