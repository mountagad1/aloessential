---
import { categoryList, localizedCategory } from "../data/categories";
import { DEFAULT_LOCALE, categoryPath, homePath, productsPath, type Locale } from "../i18n/locales";
import { productUi } from "../i18n/product-ui";
import { ui } from "../i18n/ui";
import { getArticles } from "../lib/articles";
import { getPublishedProducts } from "../lib/products";

interface Props {
  /** Category slug of the current page, for aria-current. */
  current?: string;
  locale?: Locale;
}

const { current, locale = DEFAULT_LOCALE } = Astro.props;
const t = ui(locale);

/*
 * French: the full navigation. Other locales: only sections that exist in
 * that locale (categories with published articles, the article listing, the
 * products sold in that country), so
 * navigation never leads to an empty page or silently to French.
 */
let links: { href: string; label: string; key: string }[];
if (locale === DEFAULT_LOCALE) {
  links = [
    { href: "/aloe-vera/", label: "Aloe vera", key: "aloe-vera" },
    ...categoryList.map((c) => ({ href: `/rubriques/${c.slug}/`, label: c.label, key: c.slug })),
    { href: "/articles/", label: t.allArticles, key: "articles" },
    { href: "/produits/", label: "Produits", key: "produits" },
  ];
} else {
  const present = new Set((await getArticles(locale)).map((a) => a.data.category));
  links = [
    ...categoryList
      .filter((c) => present.has(c.slug))
      .map((c) => {
        const lc = localizedCategory(c.slug, locale);
        return { href: categoryPath(locale, lc.slug), label: lc.label, key: c.slug };
      }),
    { href: homePath(locale), label: t.allArticles, key: "articles" },
  ];
  if ((await getPublishedProducts(locale)).length) {
    links.push({ href: productsPath(locale), label: productUi(locale).products, key: "produits" });
  }
}
---

<div class="header-sentinel" data-header-sentinel aria-hidden="true"></div>
<header class="site-header" data-site-header>
  <div class="container site-header__inner">
    <a class="brand" href={homePath(locale)} aria-label={t.brandHome}>
      <img src="/brand/wordmark.webp" alt="" width="433" height="80" />
    </a>

    <nav class="nav" aria-label={t.navLabel}>
      <ul class="nav__list">
        {
          links.map((link) => (
            <li>
              <a class="nav-link" href={link.href} aria-current={current === link.key ? "page" : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label={t.menuOpen}
      data-label-open={t.menuOpen}
      data-label-close={t.menuClose}
      data-menu-toggle
    >
      <span class="menu-toggle__bars" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label={t.mobileNavLabel}>
    <ul class="container">
      {
        links.map((link) => (
          <li>
            <a href={link.href} aria-current={current === link.key ? "page" : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  import "../scripts/header";
</script>
