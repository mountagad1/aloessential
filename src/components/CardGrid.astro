---
import ArticleCard from "./ArticleCard.astro";
import type { Article } from "../lib/articles";

interface Props {
  articles: Article[];
  headingLevel?: 2 | 3;
  /**
   * Number of leading cards that are likely above the fold. They render
   * immediately (no scroll reveal, no image fade) and load eagerly, so the
   * page's largest paint never waits on motion.
   */
  priority?: number;
}

const { articles, headingLevel, priority = 0 } = Astro.props;
---

<ul class="card-grid">
  {
    articles.map((article, i) => (
      <li data-reveal={i < priority ? undefined : ""}>
        <ArticleCard article={article} headingLevel={headingLevel} priority={i < priority} />
      </li>
    ))
  }
</ul>
