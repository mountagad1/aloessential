---
import Icon from "./Icon.astro";
---

<!--
  Homepage hero.
  1. The harvest photo comes first. It starts as a framed card and opens to
     the full width as the page scrolls, while « Du champ » / « au flacon »
     slide in from both sides and meet in the middle.
  2. The introduction sits under the photo; each line rises in as it enters
     the viewport, in order.
  All of it is CSS scroll-driven animation (global.css): the page scrolls
  normally, nothing is pinned or intercepted. Without support, or with
  reduced motion, everything is simply shown, still.
-->
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__visual hero-stage" data-hero-step="visual" style="--step: 0">
    <figure class="hero-stage__frame">
      <picture>
        {/* Phones show ~70 % of the wide frame: they get a 1.4:1 crop (tools/prepare-hero-media.py). */}
        <source
          media="(max-width: 30rem)"
          srcset="/media/aloe-harvest-mobile-480.webp 480w, /media/aloe-harvest-mobile-800.webp 800w, /media/aloe-harvest-mobile-1100.webp 1100w"
          sizes="100vw"
          width="1100"
          height="786"
        />
        <img
          class="hero-stage__img"
          src="/media/aloe-harvest-1024.webp"
          srcset="/media/aloe-harvest-640.webp 640w, /media/aloe-harvest-1024.webp 1024w, /media/aloe-harvest-1600.webp 1600w"
          sizes="100vw"
          alt="Dans un champ d'aloe vera, une cueilleuse coupe une feuille au couteau ; derrière elle, d'autres cueilleurs remplissent des caisses de feuilles."
          width="1600"
          height="785"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <p class="hero-stage__title" aria-hidden="true">
        <span>Du champ</span>
        <span>au flacon</span>
      </p>
      <figcaption class="hero-stage__caption">Illustration : récolte manuelle de feuilles d'aloe vera.</figcaption>
    </figure>

    <div class="hero-stage__badge" aria-hidden="true">
      <div class="accent-glow"></div>
      <div class="hero-stage__emblem accent-sway">
        <img src="/brand/icon-160.webp" alt="" width="160" height="160" decoding="async" />
      </div>
    </div>
  </div>

  <div class="container hero__intro">
    <div class="hero__heading">
      <p class="eyebrow" data-hero-scroll style="--i: 0">
        <Icon name="leaf" class="pillar-leaf" /> Naturellement essentiel
      </p>
      <h1 class="hero__title" id="hero-title" data-hero-scroll style="--i: 1">
        Votre source de <em>bien-être</em> naturelle
      </h1>
    </div>
    <div class="hero__aside">
      <p class="hero__lead" data-hero-scroll style="--i: 2">
        Conseils, santé, beauté et nutrition pour une vie plus saine, plus équilibrée et plus sereine. Une approche
        naturelle et accessible, appuyée sur des sources fiables.
      </p>
      <div class="hero__actions" data-hero-scroll style="--i: 3">
        <a class="btn" href="/rubriques/conseils/">
          Découvrir nos conseils <Icon name="arrow-right" class="btn__icon" />
        </a>
        <a class="btn btn--sun" href="/articles/">
          Explorer les articles <Icon name="arrow-right" class="btn__icon" />
        </a>
      </div>
    </div>
  </div>
</section>
