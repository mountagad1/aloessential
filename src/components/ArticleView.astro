---
/*
 * A full article page, in any locale: the French route
 * (src/pages/articles/[slug].astro) and the translated routes
 * (src/pages/[locale]/[...path].astro) both render this view.
 */
import { render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CardGrid from "./CardGrid.astro";
import Newsletter from "./Newsletter.astro";
import ReadingProgress from "./ReadingProgress.astro";
import TableOfContents from "./TableOfContents.astro";
import ProductCallout from "./ProductCallout.astro";
import { productsForArticle } from "../lib/products";
import { articleLd, breadcrumbLd, coverShareImage, organizationLd } from "../lib/seo";
import { DEFAULT_AUTHOR, DEFAULT_REVIEWER } from "../data/site";
import { localizedCategory } from "../data/categories";
import { DEFAULT_LOCALE, LOCALES, categoryPath, homePath } from "../i18n/locales";
import { ui } from "../i18n/ui";
import { articleAlternates, articleUrl, formatDate, getArticles, readingTime, type Article } from "../lib/articles";

interface Props {
  article: Article;
  /** Other published articles of the same locale, newest first. */
  others: Article[];
}

const { article, others } = Astro.props;
const { title, description, category, date, cover, coverAlt, locale } = article.data;
const t = ui(locale);
const french = locale === DEFAULT_LOCALE;
const { Content, headings } = await render(article);
const cat = localizedCategory(category, locale);
const catPath = categoryPath(locale, cat.slug);
// Translations show the products of their French source that exist in their locale.
const source = french ? article : (await getArticles()).find((a) => a.id === article.data.translationOf);
const products = await productsForArticle(article, source);
const alternates = await articleAlternates(article);
const otherVersions = alternates.filter((a) => a.locale !== locale);

const path = articleUrl(article);
const author = article.data.author ?? DEFAULT_AUTHOR;
// A translation is vouched for by the person who reviewed it in that language.
const reviewer = article.data.reviewer ?? article.data.translationReviewer ?? DEFAULT_REVIEWER;
// The team page exists in French only: links to it say so.
const teamLang = french ? undefined : "fr";
const jsonLd = [
  organizationLd(Astro.site),
  articleLd({ title, description, date, cover, path, author, inLanguage: LOCALES[locale].schemaLang }, Astro.site),
  breadcrumbLd(
    [
      { name: t.home, path: homePath(locale) },
      { name: cat.label, path: catPath },
      { name: title, path },
    ],
    Astro.site,
  ),
];
const related = [...others.filter((a) => a.data.category === category), ...others.filter((a) => a.data.category !== category)].slice(0, 3);
---

<BaseLayout
  title={title}
  description={description}
  current={category}
  ogType="article"
  jsonLd={jsonLd}
  image={coverShareImage(cover, coverAlt)}
  locale={locale}
  alternates={alternates}
>
  <article class="article" data-article>
    <ReadingProgress />

    <header class="article-header container">
      <div class="article-header__inner">
        <nav class="breadcrumb" aria-label={t.breadcrumb} data-hero-step style="--step: 0">
          <ol>
            <li><a href={homePath(locale)}>{t.home}</a></li>
            <li><a href={catPath}>{cat.label}</a></li>
            <li aria-current="page">{title}</li>
          </ol>
        </nav>
        <h1 data-hero-step style="--step: 1">{title}</h1>
        <p class="article-header__dek" data-hero-step style="--step: 2">{description}</p>
        <p class="article-meta" data-hero-step style="--step: 3">
          <a href={catPath}>{cat.label}</a>
          <span>{t.publishedOn} <time datetime={date.toISOString()}>{formatDate(date, locale)}</time></span>
          <span>{t.minRead(readingTime(article))}</span>
        </p>
        <p class="byline" data-hero-step style="--step: 3">
          {t.by} <a href="/equipe/" hreflang={teamLang}>{author}</a>{reviewer !== author && <>{` · ${t.review} `}<a href="/equipe/" hreflang={teamLang}>{reviewer}</a></>}
        </p>
        {
          otherVersions.length > 0 && (
            <p class="article-languages" data-hero-step style="--step: 3">
              {t.alsoIn}{" "}
              {/* One line on purpose: no whitespace may sit between a link and its comma. */}
              {otherVersions.map((a, i) => [i > 0 ? ", " : "", <a href={a.path} hreflang={a.hreflang} lang={a.hreflang}>{LOCALES[a.locale].name}</a>])}
            </p>
          )
        }
      </div>
    </header>

    <figure class="article-cover container" data-hero-step="visual" style="--step: 3">
      <div class="media">
        <img src={cover} alt={coverAlt} width="1200" height="800" fetchpriority="high" decoding="async" />
      </div>
    </figure>

    <div class="container">
      <div class="article-aside">
        <TableOfContents headings={headings} locale={locale} />
      </div>
      <div class="prose">
        <Content />
        {
          article.data.sources.length > 0 && (
            <section class="sources" aria-labelledby="sources-title">
              <h2 id="sources-title">{t.sources}</h2>
              <ul>
                {article.data.sources.map((s) => (
                  <li>
                    <a href={s.url} rel="noopener" target="_blank">
                      {s.title}
                      <span class="visually-hidden">{t.newTab}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>
      <p class="disclaimer prose">{t.disclaimer}</p>
      <ProductCallout products={products} locale={locale} />
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="section" aria-labelledby="related-title">
        <div class="container">
          <div class="section-head" data-reveal>
            <div>
              <p class="eyebrow">{t.relatedEyebrow}</p>
              <h2 id="related-title">{t.relatedTitle}</h2>
            </div>
          </div>
          <CardGrid articles={related} />
        </div>
      </section>
    )
  }

  {french && <Newsletter />}
</BaseLayout>
