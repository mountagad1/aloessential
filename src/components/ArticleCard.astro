---
import CoverImage from "./CoverImage.astro";
import Icon from "./Icon.astro";
import { localizedCategory } from "../data/categories";
import { ui } from "../i18n/ui";
import { articleUrl, formatDate, readingTime, type Article } from "../lib/articles";

interface Props {
  article: Article;
  headingLevel?: 2 | 3;
  /** Above-the-fold card: load eagerly and skip the image fade. */
  priority?: boolean;
}

const { article, headingLevel = 3, priority = false } = Astro.props;
const { title, description, category, date, cover, coverAlt } = article.data;
const Heading = `h${headingLevel}` as "h2" | "h3";
const { locale } = article.data;
const t = ui(locale);
---

<article class="card">
  <div class="media">
    <CoverImage
      cover={cover}
      alt={coverAlt}
      sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 50vw, 100vw"
      load={priority ? "eager" : "lazy"}
      fade={!priority}
    />
  </div>
  <div class="card__body">
    <p class="card__meta">
      <span class="card__category">{localizedCategory(category, locale).label}</span>
      <span aria-hidden="true">·</span>
      <time datetime={date.toISOString()}>{formatDate(date, locale)}</time>
    </p>
    <Heading class="card__title"><a href={articleUrl(article)}>{title}</a></Heading>
    <p class="card__excerpt">{description}</p>
    <p class="card__more" aria-hidden="true">
      {`${t.readCard(readingTime(article))} `}<Icon name="arrow-right" class="btn__icon" />
    </p>
  </div>
</article>
