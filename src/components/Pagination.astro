---
import Icon from "./Icon.astro";
import { listingPath } from "../lib/pagination";
import { DEFAULT_LOCALE, type Locale } from "../i18n/locales";
import { ui } from "../i18n/ui";

/* Previous / next links between listing pages. Renders nothing for a single page. */
interface Props {
  base: string;
  page: number;
  total: number;
  locale?: Locale;
}

const { base, page, total, locale = DEFAULT_LOCALE } = Astro.props;
const t = ui(locale);
---

{
  total > 1 && (
    <nav class="pagination" aria-label={t.pagination}>
      {page > 1 ? (
        <a class="text-link" href={listingPath(base, page - 1)} rel="prev">
          {t.previousPage}
        </a>
      ) : (
        <span />
      )}
      <p class="pagination__status">
        {t.pageStatus(page, total)}
      </p>
      {page < total ? (
        <a class="text-link" href={listingPath(base, page + 1)} rel="next">
          {`${t.nextPage} `}<Icon name="arrow-right" class="btn__icon" />
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}
