---
import { categoryList, localizedCategory } from "../data/categories";
import { LR_HOME_URL, LR_SHOP_HOME } from "../lib/partner";
import { DEFAULT_LOCALE, categoryPath, homePath, productsPath, type Locale } from "../i18n/locales";
import { productUi } from "../i18n/product-ui";
import { ui } from "../i18n/ui";
import { getArticles } from "../lib/articles";
import { getPublishedProducts } from "../lib/products";

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const t = ui(locale);
const year = new Date().getFullYear();
const french = locale === DEFAULT_LOCALE;

/* Other locales list only their own sections; French-only pages are marked as such (hreflang="fr"). */
const present = french ? null : new Set((await getArticles(locale)).map((a) => a.data.category));
const categories = categoryList
  .filter((c) => !present || present.has(c.slug))
  .map((c) =>
    french
      ? { href: `/rubriques/${c.slug}/`, label: c.label }
      : { href: categoryPath(locale, localizedCategory(c.slug, locale).slug), label: localizedCategory(c.slug, locale).label },
  );
const frenchOnly = french ? undefined : "fr";
const shopHome = LR_SHOP_HOME[locale];
const hasProducts = !french && (await getPublishedProducts(locale)).length > 0;
---

<footer class="site-footer on-dark">
  <div class="container">
    <div class="site-footer__grid">
      <div>
        <a class="site-footer__brand" href={homePath(locale)} aria-label={t.brandHome}>
          <img src="/brand/icon-160.webp" alt="" width="160" height="160" loading="lazy" />
          <img src="/brand/wordmark-white.webp" alt="" width="433" height="80" loading="lazy" />
        </a>
        <p class="site-footer__tagline">{t.footerTagline}</p>
      </div>
      <div>
        <h2>{t.footerCategories}</h2>
        <ul>
          {
            categories.map((c) => (
              <li>
                <a href={c.href}>{c.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2>{t.footerExplore}</h2>
        {
          french ? (
            <ul>
              <li><a href="/articles/">Tous les articles</a></li>
              <li><a href="/produits/">Notre sélection LR</a></li>
              <li><a href="/#newsletter">Newsletter</a></li>
              <li><a href="/aloe-vera/">Le guide de l'aloe vera</a></li>
              <li><a href="/transparence/">Transparence et liens partenaires</a></li>
              <li>
                <a href={LR_HOME_URL} target="_blank" rel="sponsored noopener">
                  Boutique officielle LR<span class="visually-hidden"> (lien partenaire, nouvel onglet)</span>
                </a>
              </li>
            </ul>
          ) : (
            <ul>
              <li><a href={homePath(locale)}>{t.allArticles}</a></li>
              {hasProducts && <li><a href={productsPath(locale)}>{productUi(locale).listingTitle}</a></li>}
              <li><a href="/" hreflang="fr" lang="fr">{t.frenchSite}</a></li>
              {shopHome && (
                <>
                  <li>
                    <a href="/transparence/" hreflang="fr">{t.transparency}{t.inFrench}</a>
                  </li>
                  <li>
                    <a href={shopHome} target="_blank" rel="sponsored noopener">
                      {t.shopLink}<span class="visually-hidden">{t.shopLinkHidden}</span>
                    </a>
                  </li>
                </>
              )}
            </ul>
          )
        }
      </div>
    </div>
    <ul class="site-footer__links">
      <li><a href="/equipe/" hreflang={frenchOnly}>{t.team}{t.inFrench}</a></li>
      <li><a href="/contact/" hreflang={frenchOnly}>{t.contact}{t.inFrench}</a></li>
      <li><a href="/mentions-legales/" hreflang={frenchOnly}>{t.legalNotice}{t.inFrench}</a></li>
      <li><a href="/confidentialite/" hreflang={frenchOnly}>{t.privacy}{t.inFrench}</a></li>
    </ul>
    <p class="site-footer__legal">{t.footerLegal(year)}</p>
  </div>
</footer>
