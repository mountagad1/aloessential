---
import { categoryList } from "../data/categories";

const year = new Date().getFullYear();
---

<footer class="site-footer on-dark">
  <div class="container">
    <div class="site-footer__grid">
      <div>
        <a class="site-footer__brand" href="/" aria-label="Aloessential — accueil">
          <img src="/brand/icon-160.webp" alt="" width="160" height="160" loading="lazy" />
          <img src="/brand/wordmark-white.webp" alt="" width="433" height="80" loading="lazy" />
        </a>
        <p class="site-footer__tagline">Naturellement essentiel</p>
      </div>
      <div>
        <h2>Rubriques</h2>
        <ul>
          {
            categoryList.map((c) => (
              <li>
                <a href={`/rubriques/${c.slug}/`}>{c.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2>Explorer</h2>
        <ul>
          <li><a href="/articles/">Tous les articles</a></li>
          <li><a href="/#newsletter">Newsletter</a></li>
        </ul>
      </div>
    </div>
    <p class="site-footer__legal">
      © {year} Aloessential. Les contenus de ce site sont informatifs et ne remplacent pas l'avis d'un professionnel de santé.
    </p>
  </div>
</footer>
