---
import ArticleView from "../../components/ArticleView.astro";
import { getArticles, type Article } from "../../lib/articles";

/* French articles. Translations are rendered by src/pages/[locale]/[...path].astro. */
export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article, others: articles.filter((a) => a.id !== article.id) },
  }));
}

interface Props {
  article: Article;
  others: Article[];
}

const { article, others } = Astro.props;
---

<ArticleView article={article} others={others} />
