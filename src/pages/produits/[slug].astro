---
import ProductView from "../../components/ProductView.astro";
import { getPublishedProducts, type Product } from "../../lib/products";

export async function getStaticPaths() {
  const products = await getPublishedProducts();
  return products.map((product) => ({ params: { slug: product.id }, props: { product } }));
}

interface Props {
  product: Product;
}
---

<ProductView product={Astro.props.product} />
