---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CardGrid from "../../components/CardGrid.astro";
import Icon from "../../components/Icon.astro";
import ShopButton from "../../components/ShopButton.astro";
import StickyCta from "../../components/StickyCta.astro";
import { CATEGORIES } from "../../data/categories";
import { formatDate, getArticles } from "../../lib/articles";
import { getPublishedProducts, KIND_LABEL, SUPPLEMENT_MENTIONS, type Product } from "../../lib/products";
import { breadcrumbLd, coverShareImage } from "../../lib/seo";

export async function getStaticPaths() {
  const products = await getPublishedProducts();
  return products.map((product) => ({ params: { slug: product.id }, props: { product } }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const d = product.data;
const { Content } = await render(product);
const cat = CATEGORIES[d.category];

// Articles that cite this product first, then same-category articles.
const articles = await getArticles();
const citing = articles.filter((a) => a.data.products.some((ref) => ref.id === product.id));
const related = [...citing, ...articles.filter((a) => !citing.includes(a) && a.data.category === d.category)].slice(0, 3);

const isSupplement = d.kind === "complement";

// The page reviews the product; it does not sell it, so no Product/Offer markup.
const seoTitle = `${d.name} : composition et avis`;
const jsonLd = [
  breadcrumbLd(
    [
      { name: "Accueil", path: "/" },
      { name: "Produits", path: "/produits/" },
      { name: d.name, path: `/produits/${product.id}/` },
    ],
    Astro.site,
  ),
];
---

<BaseLayout
  title={seoTitle}
  description={d.tagline}
  current="produits"
  jsonLd={jsonLd}
  image={coverShareImage(d.cover, d.coverAlt)}
>
  <article class="product">
    <header class="product-hero">
      <div class="container product-hero__grid">
        <figure class="product-hero__visual media" data-hero-step="visual" style="--step: 1">
          <img src={d.cover} alt={d.coverAlt} width="1200" height="800" fetchpriority="high" decoding="async" />
        </figure>

        <div class="product-hero__body">
          <nav class="breadcrumb" aria-label="Fil d'Ariane" data-hero-step style="--step: 0">
            <ol>
              <li><a href="/">Accueil</a></li>
              <li><a href="/produits/">Produits</a></li>
              <li aria-current="page">{d.name}</li>
            </ol>
          </nav>
          <p class="eyebrow" data-hero-step style="--step: 0">{d.range} · {KIND_LABEL[d.kind]}</p>
          <h1 data-hero-step style="--step: 1">{d.name}</h1>
          <p class="product-hero__tagline" data-hero-step style="--step: 2">{d.tagline}</p>
          <p class="product-hero__summary" data-hero-step style="--step: 2">{d.summary}</p>

          <div class="product-hero__actions" data-hero-step style="--step: 3" data-sticky-start>
            <ShopButton href={d.shopUrl} productName={d.name} />
            <a class="btn btn--outline" href="#avis">Lire notre avis <Icon name="arrow-right" class="btn__icon" /></a>
          </div>
          <!-- Right under the first CTA, so it is read before any click. -->
          <p class="disclosure-inline" data-hero-step style="--step: 3">
            <Icon name="info" /> Lien partenaire : nous pouvons percevoir une commission, sans surcoût pour vous.{" "}
            <a href="/transparence/">En savoir plus</a>
          </p>
          <ul class="product-facts" data-hero-step style="--step: 3">
            {d.format && <li><Icon name="check" /> {d.format}</li>}
            <li><Icon name="check" /> Réf. LR {d.sku}</li>
            <li><Icon name="check" /> Prix et disponibilité sur la boutique officielle</li>
          </ul>
        </div>
      </div>
    </header>

    {
      d.highlights.length > 0 && (
        <section class="section section--tight" aria-labelledby="highlights-title">
          <div class="container">
            <h2 class="visually-hidden" id="highlights-title">Les points clés</h2>
            <ul class="highlights">
              {d.highlights.map((h) => (
                <li class="highlight" data-reveal>
                  <span class:list={["pillar__icon", { "pillar__icon--sun": h.icon === "sun" }]}>
                    <Icon name={h.icon} />
                  </span>
                  <h3>{h.title}</h3>
                  <p>{h.text}</p>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <div class="container product-layout">
      <div class="product-main">
        <section id="avis" aria-labelledby="avis-title">
          <h2 id="avis-title" class="product-section-title">Notre avis</h2>
          <div class="prose">
            <Content />
          </div>
        </section>

        {
          d.forWhom.length > 0 && (
            <section class="product-block" aria-labelledby="pour-qui-title" data-reveal>
              <h2 id="pour-qui-title" class="product-section-title">Pour qui ?</h2>
              <ul class="check-list">
                {d.forWhom.map((item) => (
                  <li><Icon name="check" /> {item}</li>
                ))}
              </ul>
            </section>
          )
        }

        {
          d.composition.length > 0 && (
            <section class="product-block" aria-labelledby="composition-title" data-reveal>
              <h2 id="composition-title" class="product-section-title">Composition</h2>
              <div class="table-wrap">
                <table class="composition">
                  <thead>
                    <tr>
                      <th scope="col">Ingrédient</th>
                      <th scope="col">Quantité</th>
                    </tr>
                  </thead>
                  <tbody>
                    {d.composition.map((c) => (
                      <tr>
                        <th scope="row">
                          {c.name}
                          {c.note && <span class="composition__note">{c.note}</span>}
                        </th>
                        <td>{c.amount ?? "—"}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              {d.compositionNote && <p class="small-print">{d.compositionNote}</p>}
            </section>
          )
        }

        {
          d.usage.length > 0 && (
            <section class="product-block" aria-labelledby="usage-title" data-reveal>
              <h2 id="usage-title" class="product-section-title">Mode d'emploi</h2>
              <ol class="steps">
                {d.usage.map((step) => <li>{step}</li>)}
              </ol>
            </section>
          )
        }

        {
          (d.precautions.length > 0 || isSupplement) && (
            <section class="product-block product-block--notice" aria-labelledby="precautions-title" data-reveal>
              <h2 id="precautions-title" class="product-section-title">Précautions</h2>
              <ul>
                {d.precautions.map((p) => <li>{p}</li>)}
                {isSupplement && SUPPLEMENT_MENTIONS.map((m) => <li>{m}</li>)}
              </ul>
              <p class="small-print">
                Ces informations ne remplacent pas l'avis d'un professionnel de santé. Demandez conseil à votre médecin ou
                pharmacien en cas de grossesse, d'allaitement, de traitement en cours ou de doute.
              </p>
            </section>
          )
        }

        {
          d.faq.length > 0 && (
            <section class="product-block" aria-labelledby="faq-title" data-reveal>
              <h2 id="faq-title" class="product-section-title">Questions fréquentes</h2>
              <div class="faq">
                {d.faq.map((item) => (
                  <details class="faq__item">
                    <summary>
                      {item.q} <Icon name="chevron-down" class="toc__chevron" />
                    </summary>
                    <p>{item.a}</p>
                  </details>
                ))}
              </div>
            </section>
          )
        }

        {
          d.sourceCheckedAt && (
            <p class="small-print">
              Informations produit vérifiées le{" "}
              <time datetime={d.sourceCheckedAt.toISOString()}>{formatDate(d.sourceCheckedAt)}</time> sur la boutique
              officielle LR. La composition peut évoluer : seul l'étiquetage du produit fait foi.
            </p>
          )
        }
      </div>
    </div>

    <section class="section section--tight" aria-labelledby="final-cta-title">
      <div class="container">
        <div class="final-cta on-dark" data-reveal data-sticky-end>
          <p class="eyebrow" style="color: var(--color-sun)">{d.range}</p>
          <h2 id="final-cta-title">{d.name}</h2>
          <p>{d.tagline}</p>
          <ShopButton href={d.shopUrl} productName={d.name} label="Commander sur la boutique LR" />
          <p class="final-cta__note">
            Commande, paiement et livraison sont assurés par LR Health &amp; Beauty. Lien partenaire —{" "}
            <a href="/transparence/">notre transparence</a>.
          </p>
        </div>
      </div>
    </section>
  </article>

  {
    related.length > 0 && (
      <section class="section" aria-labelledby="related-title">
        <div class="container">
          <div class="section-head" data-reveal>
            <div>
              <p class="eyebrow">{cat.label}</p>
              <h2 id="related-title">À lire sur le sujet</h2>
            </div>
          </div>
          <CardGrid articles={related} />
        </div>
      </section>
    )
  }

  <StickyCta href={d.shopUrl} productName={d.name} />
</BaseLayout>
