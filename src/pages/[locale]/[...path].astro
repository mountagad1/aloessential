---
/*
 * Every page of every non-French locale, generated only from published
 * translations (docs/architecture/INTERNATIONAL_SEO_ARCHITECTURE.md):
 *   /<locale>/                         all articles (page 1), /<locale>/2/ …
 *   /<locale>/<categories>/<slug>/     one category, paginated the same way
 *   /<locale>/<articles>/<slug>/       one article
 *   /<locale>/<products>/              products LR sells in that country
 *   /<locale>/<products>/<slug>/       one product, with that country's shop link
 *   WATERING_UI[locale].path           the aloe vera watering planner
 * A locale with no published article has no page at all: nothing falls back
 * to French under a foreign prefix.
 */
import ArticleView from "../../components/ArticleView.astro";
import LocaleListing from "../../components/LocaleListing.astro";
import ProductListing from "../../components/ProductListing.astro";
import ProductView from "../../components/ProductView.astro";
import WateringPlannerView from "../../components/WateringPlannerView.astro";
import { WATERING_UI } from "../../i18n/watering-ui";
import { categoryList, localizedCategory, type CategorySlug } from "../../data/categories";
import { LOCALES, categoryPath, homePath, type Locale } from "../../i18n/locales";
import { ui } from "../../i18n/ui";
import {
  articleSlug,
  categoryAlternates,
  getArticles,
  getTranslatedLocales,
  homeAlternates,
  type Alternate,
  type Article,
} from "../../lib/articles";
import { listingPages, pageCount, pageSlice } from "../../lib/pagination";
import { getProductLocales, getPublishedProducts, productSlug, type Product } from "../../lib/products";

type PageProps =
  | { kind: "article"; article: Article; others: Article[] }
  | { kind: "products" }
  | { kind: "product"; product: Product }
  | { kind: "watering" }
  | {
      kind: "listing";
      category?: CategorySlug;
      all: Article[];
      page: number;
      pages: number;
      base: string;
      categories: CategorySlug[];
      alternates: Alternate[];
    };

export async function getStaticPaths() {
  const paths: { params: { locale: string; path: string | undefined }; props: PageProps }[] = [];
  const homeAlts = await homeAlternates();
  const locales = await getTranslatedLocales();
  for (const locale of await getProductLocales()) {
    if (!locales.includes(locale)) throw new Error(`"${locale}" has product pages but no published article: publish articles first`);
  }
  for (const locale of locales) {
    ui(locale); // fails the build if the locale has no interface text yet
    const l = LOCALES[locale];
    const articles = await getArticles(locale);
    const categories = categoryList.map((c) => c.slug).filter((slug) => articles.some((a) => a.data.category === slug));
    const sub = (path: string) => path.slice(l.prefix.length + 1, -1) || undefined; // "/it/a/b/" → "a/b"

    for (const p of listingPages(homePath(locale), articles.length)) {
      paths.push({
        params: { locale, path: sub(p.path) },
        props: { kind: "listing", all: articles, page: p.page, pages: pageCount(articles.length), base: homePath(locale), categories, alternates: homeAlts },
      });
    }

    for (const category of categories) {
      const inCategory = articles.filter((a) => a.data.category === category);
      const base = categoryPath(locale, localizedCategory(category, locale).slug);
      const alternates = await categoryAlternates(category, (loc) => localizedCategory(category, loc).slug);
      for (const p of listingPages(base, inCategory.length)) {
        paths.push({
          params: { locale, path: sub(p.path) },
          props: { kind: "listing", category, all: inCategory, page: p.page, pages: pageCount(inCategory.length), base, categories, alternates },
        });
      }
    }

    for (const article of articles) {
      paths.push({
        params: { locale, path: `${l.segments.articles}/${articleSlug(article)}` },
        props: { kind: "article", article, others: articles.filter((a) => a.id !== article.id) },
      });
    }

    const products = await getPublishedProducts(locale);
    if (products.length) paths.push({ params: { locale, path: l.segments.products }, props: { kind: "products" } });
    for (const product of products) {
      paths.push({ params: { locale, path: `${l.segments.products}/${productSlug(product)}` }, props: { kind: "product", product } });
    }

    paths.push({ params: { locale, path: sub(WATERING_UI[locale].path) }, props: { kind: "watering" } });
  }
  return paths;
}

const props = Astro.props as PageProps;
const locale = Astro.params.locale as Locale;
---

{
  props.kind === "article" ? (
    <ArticleView article={props.article} others={props.others} />
  ) : props.kind === "products" ? (
    <ProductListing locale={locale} />
  ) : props.kind === "product" ? (
    <ProductView product={props.product} />
  ) : props.kind === "watering" ? (
    <WateringPlannerView locale={locale} />
  ) : (
    <LocaleListing
      locale={locale}
      category={props.category}
      articles={pageSlice(props.all, props.page)}
      total={props.all.length}
      page={props.page}
      pages={props.pages}
      base={props.base}
      categories={props.categories}
      alternates={props.alternates}
    />
  )
}
