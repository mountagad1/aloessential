---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { breadcrumbLd } from "../../../lib/seo";
import CardGrid from "../../../components/CardGrid.astro";
import Newsletter from "../../../components/Newsletter.astro";
import { CATEGORIES, categoryList, type CategorySlug } from "../../../data/categories";
import Pagination from "../../../components/Pagination.astro";
import { getArticles, type Article } from "../../../lib/articles";
import { listingPages, pageSlice } from "../../../lib/pagination";

/* /rubriques/<slug>/ is page 1; /rubriques/<slug>/2/… follow (src/lib/pagination.ts). */
export async function getStaticPaths() {
  const articles = await getArticles();
  return categoryList.flatMap((c) => {
    const inCategory = articles.filter((a) => a.data.category === c.slug);
    return listingPages(`/rubriques/${c.slug}/`, inCategory.length).map(({ page, param }, _, all) => ({
      params: { slug: c.slug, page: param },
      props: { page, pages: all.length, all: inCategory },
    }));
  });
}

interface Props {
  page: number;
  pages: number;
  all: Article[];
}

const { page, pages, all } = Astro.props;
const slug = Astro.params.slug as CategorySlug;
const category = CATEGORIES[slug];
const base = `/rubriques/${slug}/`;
const articles = pageSlice(all, page);
const suffix = page > 1 ? ` (page ${page})` : "";
const jsonLd = [
  breadcrumbLd(
    [
      { name: "Accueil", path: "/" },
      { name: category.label, path: base },
    ],
    Astro.site,
  ),
];
---

<BaseLayout
  title={`${category.label}${suffix}`}
  description={page > 1 ? `${category.description} Page ${page}.` : category.description}
  current={slug}
  jsonLd={jsonLd}
>
  <header class="page-header">
    <div class="container">
      <p class="eyebrow" data-hero-step style="--step: 0">Rubrique</p>
      <h1 data-hero-step style="--step: 1">{category.label}{suffix}</h1>
      <p data-hero-step style="--step: 2">{category.description}</p>
      <ul class="chip-list" aria-label="Changer de rubrique" data-hero-step style="--step: 3">
        <li><a class="chip" href="/articles/">Tout</a></li>
        {
          categoryList.map((c) => (
            <li>
              <a class="chip" href={`/rubriques/${c.slug}/`} aria-current={c.slug === slug && page === 1 ? "page" : undefined}>
                {c.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </header>

  <section class="section section--tight" aria-label={`Articles de la rubrique ${category.label}`}>
    <div class="container">
      {
        page === 1 && (
          <div class="rubrique-intro prose">
            {category.intro.map((p) => <p>{p}</p>)}
          </div>
        )
      }
      {
        articles.length ? (
          <>
            <CardGrid articles={articles} headingLevel={2} priority={3} />
            <Pagination base={base} page={page} total={pages} />
          </>
        ) : (
          <p>Aucun article dans cette rubrique pour le moment.</p>
        )
      }
    </div>
  </section>

  <Newsletter />
</BaseLayout>
